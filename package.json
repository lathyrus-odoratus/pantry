{
  "name": "pantry",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:backend": "pnpm --filter @pantry/backend dev",
    "dev:client": "pnpm --filter @lathyrus-odoratus/pantry dev",
    "admin": "pnpm --filter @pantry/backend admin",
    "deploy": "./scripts/deploy.sh",
    "deploy:with-notice": "./scripts/deploy-with-notice.sh"
  },
  "packageManager": "pnpm@9.0.0"
}
