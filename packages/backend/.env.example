# Server
PORT=8080
NODE_ENV=development
PUBLIC_BACKEND_URL=http://localhost:8080

# Postgres. Migrations in migrations/ run on startup.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pantry

# Throwaway database for src/db/db.test.ts (it truncates tables). Leave unset
# to skip those tests. Never point this at a real database.
# TEST_DATABASE_URL=

# JWT
JWT_SIGNING_KEY=replace-with-long-random-string

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin (optional) — shared secret used by `pnpm admin announce`
ADMIN_KEY=

# World feature (TRPG roguelike). When ANTHROPIC_API_KEY is unset, /the-world
# responds with an error and the feature is effectively disabled.
ANTHROPIC_API_KEY=
WORLD_CREDIT_TOTAL=100000

# GitHub→Discord relay (POST /relay/github). Forwards GitHub webhook events to a
# Discord forum thread (thread_id comes from the ?thread_id query param). When
# either var is unset the endpoint returns 503. GITHUB_WEBHOOK_SECRET is the
# shared secret used to verify the X-Hub-Signature-256 header.
DISCORD_WEBHOOK_URL=
GITHUB_WEBHOOK_SECRET=
