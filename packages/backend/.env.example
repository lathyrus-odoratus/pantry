# Server
PORT=8080
NODE_ENV=development
PUBLIC_BACKEND_URL=http://localhost:8080

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SIGNING_KEY=replace-with-long-random-string

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Admin (optional) — shared secret used by `pnpm admin announce`
ADMIN_KEY=

# World feature (TRPG roguelike). When ANTHROPIC_API_KEY is unset, /the-world
# responds with an error and the feature is effectively disabled.
ANTHROPIC_API_KEY=
WORLD_CREDIT_TOTAL=100000
