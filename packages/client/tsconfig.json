{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@pantry/shared": ["../shared/src/index.ts"],
      "@pantry/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "../shared/src/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "../shared/src/**/*.test.ts"
  ]
}
